{
  "server": {
    "port": 8792,
    "apiKey": "${MYAPI_API_KEY}",
    "strategy": "weighted",
    "maxAttempts": 3,
    "timeoutMs": 180000,
    "cooldownMs": 30000,
    "healthIntervalMs": 60000
  },
  "channels": [
    {
      "id": "workbuddy",
      "name": "WorkBuddy",
      "plugin": "openai-compatible",
      "baseUrl": "http://host.docker.internal:8788/v1",
      "apiKeyEnv": "WB_API_KEY",
      "weight": 3,
      "priority": 0
    },
    {
      "id": "trae",
      "name": "Trae CN",
      "plugin": "openai-compatible",
      "baseUrl": "http://host.docker.internal:8791/v1",
      "apiKeyEnv": "TRAE_API_KEY",
      "weight": 2,
      "priority": 0
    },
    {
      "id": "proxy",
      "name": "proxy-hub",
      "plugin": "openai-compatible",
      "baseUrl": "http://host.docker.internal:8787/v1",
      "apiKeyEnv": "PROXY_HUB_API_KEY",
      "weight": 1,
      "priority": 1,
      "aliases": {
        "traecn-glm-5.2": "glm-5.2",
        "traecn-glm-5.1": "glm-5.1",
        "traecn-glm-5": "glm-5",
        "traecn-qwen-3.7-plus": "qwen-3.7-plus",
        "traecn-kimi-k2.6": "kimi-k2.6",
        "traecn-deepseek-v4-pro": "deepseek-v4-pro",
        "traecn-deepseek-v4-flash": "deepseek-v4-flash"
      }
    },
    {
      "id": "qoder",
      "name": "Qoder",
      "plugin": "openai-compatible",
      "enabled": false,
      "baseUrl": "http://host.docker.internal:8790/v1",
      "apiKeyEnv": "QODER_API_KEY",
      "weight": 2,
      "priority": 0,
      "tasks": [
        {
          "id": "daily-checkin",
          "name": "每日签到",
          "at": "09:10",
          "method": "POST",
          "path": "/tasks/run",
          "json": {}
        }
      ]
    }
  ]
}
